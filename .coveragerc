[run]
source = src
omit =
    # Requires Hugging Face download — not unit-testable
    src/data/download.py
    # Requires training data + GPU — integration test only
    src/models/train.py
    # Generates plots — not unit-testable
    src/data/eda.py
    # Requires running API + true labels — integration test only
    src/api/drift.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
